///|
/// Kitchen-sink registry used by the CLI and to keep every ABI constructor live.
pub fn demo_registry() -> Registry {
  let reg = Registry::new()
  ignore(Bool)
  ignore(S8)
  ignore(S16)
  ignore(S32)
  ignore(S64)
  ignore(ValType::F32)
  ignore(ValType::F64)
  ignore(ValType::Char)
  ignore(ValType::String)
  ignore(ValType::ErrorContext)
  ignore(ValType::U64)
  ignore(DiscInt::U64)
  ignore(GuestImport)
  ignore(GuestExport)
  ignore(reg.add(Map(U8, U16)))
  ignore(reg.add(FixedList(U16, 3)))
  ignore(reg.add(Future))
  ignore(reg.add(Stream))
  ignore(reg.add(Resource))
  ignore(reg.add(List(U8)))
  ignore(reg.add(Flags(3)))
  ignore(reg.add(Enum(4)))
  ignore(reg.add(Option(U32)))
  ignore(reg.add(Result(Some(U32), Some(F32))))
  ignore(reg.add(Record([Field::new("x", U8)])))
  ignore(reg.add(Tuple([U8, U16])))
  ignore(reg.add(Variant([Case::new("a", None), Case::new("b", Some(U32))])))
  ignore(reg.add(Handle))
  ignore(reg.add(Alias(U32)))
  reg
}
